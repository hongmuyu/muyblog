// Sidebar Navigation
.sidebar-nav {
  margin: 0;
  padding-bottom: 20px;
  padding-left: 0;

  li {
    border-bottom: 1px solid transparent;
    color: $sidebar-nav-color;
    cursor: pointer;
    display: inline-block;
    font-size: $font-size-small;

    &.sidebar-nav-overview {
      margin-left: 10px;
    }

    &:hover {
      color: $sidebar-nav-hover-color;
    }
  }

  .sidebar-nav-active {
    border-bottom-color: $sidebar-highlight;
    // 主题 D 可访问性修复：#fc6423 在白底上对比度仅 3.0，加深到 #c74f1c（4.60:1）
    color: #c74f1c;

    &:hover {
      color: #c74f1c;
    }
  }
}

.sidebar-panel {
  display: none;
  overflow-x: hidden;
  overflow-y: auto;
}

.sidebar-panel-active {
  display: block;
}
