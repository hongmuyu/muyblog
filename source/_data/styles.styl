    height: 110px
    border-radius: 50%
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12)

  h1
    margin: 0.6rem 0 0.2rem

  blockquote
    display: inline-block
    margin: 0.4rem auto 0
    border-left: none
