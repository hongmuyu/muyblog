    font-style: italic

// ============ 碎碎念时间线 ============
.moments-subtitle
  color: var(--text-color-secondary, #999)
  margin-bottom: 1.5rem

.moments-list
  margin: 1rem 0
  padding-left: 18px
  border-left: 2px solid rgba(102, 126, 234, 0.25)

.moment-item
