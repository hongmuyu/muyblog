    border-color: #222
    color: #fff

.secret-error
  margin-top: 0.9em
  font-size: 82%
  color: #4a4a4a
  font-weight: 500

.secret-list
  margin-top: 1.5em
  text-align: left

.secret-item
  display: flex
  align-items: baseline
  padding: 0.55em 0.2em
  border-bottom: 1px dashed #ececec
  color: #333
  text-decoration: none

.secret-item-date
  flex: none
  width: 6.5em
  color: #b3b3b3
  font-size: 82%

.secret-item-title
  flex: 1
  transition: color 0.2s ease

.secret-item:hover .secret-item-title
  color: #000
  text-decoration: underline

.secret-empty
  margin-top: 1.5em
  color: #999
  font-size: 90%

.secret-hint
  margin-top: 2.2em
  padding-top: 0.9em
  border-top: 1px dashed #e0e0e0
  color: #b3b3b3
  font-size: 13px

// ============================================
// 文章信息（日期/分类/字数）对比度修正
// 原颜色 #999 在白底上对比度仅约 2.85:1，加深到 #767676（约 4.54:1，满足 WCAG AA）
// ============================================
.posts-expand .post-meta,
.post-meta
  color: #767676
