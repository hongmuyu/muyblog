// ============ 数据图表页 ============
.charts-subtitle
  color: var(--text-color-secondary, #999)
  margin-bottom: 1.5rem

.chart-summary
  display: grid
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr))
  gap: 12px
  margin: 1rem 0 2rem

.chart-stat
  display: flex
  flex-direction: column
  align-items: center
  gap: 4px
  padding: 16px 8px
  border-radius: 12px
  background: var(--card-bg-color, #fff)
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06)

  strong
    font-size: 1.3em
    color: #667eea

  span
    font-size: 0.82em
    color: var(--text-color-secondary, #888)

.chart-section
  margin-bottom: 2rem

  h3
    margin: 0 0 0.8rem
    font-size: 1.05em

    i
      color: #667eea
      margin-right: 6px

.chart-row
  display: flex
  align-items: center
  gap: 10px
  margin-bottom: 8px

.chart-label
  flex: 0 0 8.5em
