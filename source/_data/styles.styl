// ============ 侧栏统计补充行 ============
.site-state-extra
  margin-top: 12px

  .site-state-item-count
    font-size: 1em

// ============ 加密文章密码框 ============
// 灰白黑极简风格：线条式无边框输入框 + 灰色提示语 + 黑色幽灵按钮
// 插件 CSS 在页面末尾注入，用容器 ID 前缀（1,1,0）确保压过其全部规则
// 插件的标签带绝对定位色块伪元素（::before/::after 深灰滑入动画），必须显式清除
// 注意：插件仅绑定按钮 click（无回车提交），按钮保留
#hexo-blog-encrypt
  .hbe-content
    max-width: 480px
    margin: 0 auto
    padding: 3.5em 1em 2.5em
    background: none
    border: none

  .hbe-form
    padding: 0
    text-align: center

  // 彻底清除插件标签的装饰伪元素（深灰色块与下划线动画）
  .hbe-input-label::before,
  .hbe-input-label::after
    display: none
    content: none

  .hbe-input
    display: block
    float: none
    width: 100%
    min-width: 0
    margin: 0

  // 线条式输入框：只留上下两条细线，聚焦时变黑
  // 插件默认失焦时 opacity: 0（浮动标签模式），必须强制可见
  .hbe-input-field
    display: block
    float: none
    width: 100%
    margin: 0
    padding: 1.2em 0.5em
    border: none
    border-top: 1px solid #d9d9d9
    border-bottom: 1px solid #d9d9d9
    border-radius: 0
    background: none
    color: #333
    font-size: 100%
    opacity: 1
    text-align: center
    letter-spacing: 0.35em
    box-shadow: none
    transition: border-color 0.25s ease

    &:focus
      outline: none
      border-top-color: #222
      border-bottom-color: #222
      box-shadow: none

  // Chrome 自动填充的蓝底还原为白色
  .hbe-input-field:-webkit-autofill
    -webkit-box-shadow: 0 0 0 1000px #fff inset
    -webkit-text-fill-color: #333

  .hbe-input-label
    display: block
    position: static
    float: none
    width: 100%
    padding: 0
    margin: 0.9em 0 0
    background: none
    font-weight: normal
    pointer-events: auto

  // 提示语：灰色小字居中
  // 插件在已填/聚焦状态下会把它推下 2.1em 并缩到 0.65 倍，必须锁死 transform
  .hbe-input-label-content
    display: block
    position: static
    width: 100%
    padding: 0
    background: none
    color: #999
    font-size: 13px
    text-align: center
    transform: none

  // 黑色幽灵按钮：灰底黑字描边，悬停填充纯黑
  .hbe-button
    display: inline-block
    width: auto
    height: auto
    padding: 0.45em 1.8em
    margin: 1.5em auto 0
    border: 1px solid #444
    border-radius: 999px
    background: none
    color: #333
    font-size: 85%
    font-weight: normal
    letter-spacing: 0.3em
    cursor: pointer
    transition: all 0.25s ease

    &:hover
      background: #222
      border-color: #222
      color: #fff

  // 底部：虚线分隔 + 居中小锁图标（灰色系）
  .hbe-form::after
    content: "\f023"
    font-family: "Font Awesome 5 Free"
    font-weight: 900
    display: block
    width: 100%
    margin-top: 2.2em
    padding-top: 0.9em
    border-top: 1px dashed #e0e0e0
    color: #b3b3b3
    font-size: 15px
    text-align: center

  // 错误提示：中和插件的粉色框为灰色系
  .hbe-error
    display: inline-block
    margin-top: 1em
    padding: 0.4em 1.2em
    background: #f6f6f6
    border-radius: 6px
    font-size: 82%
    color: #4a4a4a
    font-weight: 500

// ============ 私密分类入口页 ============
// 与加密文章页同一套灰白黑视觉：线条式输入、幽灵胶囊按钮、虚线收尾
